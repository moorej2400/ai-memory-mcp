# Copy this file to .env. Process environment variables override these values.

# Canonical writable Markdown memory root.
# Forward slashes work on Windows, macOS, and Linux.
# Windows example: "C:/path/to/AI-Memory"
# macOS and Linux example: "~/AI-Memory"
AI_MEMORY_WORK_DIR="~/AI-Memory"
AI_MEMORY_PRIMARY_SOURCE_ID="core"

# Optional retrieval-only Markdown memory sources
AI_MEMORY_PERSONAL_DIR=""
AI_MEMORY_RETRIEVAL_SOURCES='{"archive":"~/Archive","reference":"~/Reference"}'

# Optional local terms that must not occur in commit-eligible files
AI_MEMORY_PRIVATE_REPOSITORY_TERMS=""

# AI Memory stores internal data under AI_MEMORY_WORK_DIR/.ai-memory.
# Advanced installations can override the individual paths.
AI_MEMORY_ARTIFACT_BATCH_MAX_BYTES="268435456"
AI_MEMORY_GENERATION_RETENTION_COUNT="2"
AI_MEMORY_GENERATION_LEASE_TTL_SECONDS="86400"

# Optional JSON pairs for machine-specific live retrieval checks.
# Each pair is a question and a marker that the evidence must contain.
AI_MEMORY_RETRIEVAL_EVAL_CASES=""
